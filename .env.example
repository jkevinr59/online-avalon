# Copy to .env and adjust. `npm run dev` and `npm start` load it automatically.
# Variables already set in the environment (e.g. by systemd) take precedence.

# Port the server listens on. The Vite dev server proxies to 3000, so keep 3000 for local dev.
PORT=3000

# Shared password every player types on the join screen.
PLAYER_PASSWORD=avalon

# Password for the host dashboard at /host.
HOST_PASSWORD=avalon-host

# SQLite file location. Defaults to ./data/avalon.db when unset.
# DB_PATH=./data/avalon.db

# How long (in ms) everyone sees a vote / quest result before the game moves on.
# RESULT_PAUSE_MS=10000
# Shorter pause (in ms) when the team is approved and leaves for its quest.
# DEPART_PAUSE_MS=5000

# Development only: players named alwaysgood / alwaysevil / alwaysmerlin (optionally followed by
# anything, e.g. alwaysevil2) get that role, first joined first. `npm run dev` turns it on.
# Never enable it for real games.
# DEV_ROLES=1
