[Unit]
Description=Avalon Online
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=avalon
WorkingDirectory=/opt/avalon-online
Environment=NODE_ENV=production
Environment=PORT=80
# Change these two before starting the service!
Environment=PLAYER_PASSWORD=change-me
Environment=HOST_PASSWORD=change-me-too
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning --max-old-space-size=256 server/index.js
Restart=always
RestartSec=2
# Lets a non-root user listen on port 80.
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
